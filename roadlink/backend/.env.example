# RoadLink Backend Environment Variables
# Copy this file to .env and customize as needed.

# App
ENV=development

# Local SQLite is the default and needs no separate database service.
DATABASE_URL=sqlite+aiosqlite:///./roadlink.db
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:
# Optional PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://roadlink:change_me@localhost:5432/roadlink
# TEST_DATABASE_URL=postgresql+asyncpg://roadlink:change_me@localhost:5432/roadlink_test

# JWT (must be at least 32 characters)
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_STRING_AT_LEAST_32_CHARS
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=2592000

# CORS
CORS_ORIGINS=http://localhost:5173

# Storage
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_IMAGE_BYTES=5242880

# AI (optional; requires local Ollama)
AI_PROVIDER=none
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b
AI_TIMEOUT_S=8
AI_MAX_INPUT_CHARS=1000

# Web Push / VAPID (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:roadlink@example.com

# Maps / Places
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
PLACES_CACHE_TTL_S=600

# SOS / location
RADIUS_OPTIONS_M=5000,10000,25000,50000,100000
SOS_RADIUS_STAGES_M=5000,15000,30000,50000,100000
SOS_STAGE_DELAYS_S=0,180,300,420,600
SOS_CRITICAL_DELAY_FACTOR=0.5
SOS_OPEN_TTL_S=10800
SOS_ACTIVE_TTL_S=43200
SOS_MAX_ACTIVE_PER_USER=3
SOS_COOLDOWN_S=120
ACTIVE_WINDOW_S=120
SOS_LOCATION_MAX_AGE_S=1800
LOCATION_MIN_INTERVAL_S=5
LOCATION_MAX_ACCURACY_M=1000
LOCATION_RETENTION_HOURS=24

# Community / chat
COMMUNITY_MESSAGE_TTL_S=7200
CHAT_RETENTION_DAYS=30
CONVERSATION_CLOSE_GRACE_S=86400

# Safety
REPORT_RESTRICT_THRESHOLD=5
EMERGENCY_NUMBER=112
